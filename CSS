:root {
  --bg: #0d1015;
  --bg-2: #111821;
  --panel: #121b22;
  --line: rgba(255,255,255,0.12);
  --text: #edf3ff;
  --muted: #aeb7c4;
  --blue: #2f76d2;
  --blue-2: #1b5ab7;
  --button: #171d24;
  --shadow: rgba(0,0,0,0.5);
}

* {
  box-sizing: border-box;
}

html, body {
  margin: 0;
  min-height: 100%;
  background: var(--bg);
  color: var(--text);
  font-family: "Roboto", sans-serif;
}

body {
  background:
    linear-gradient(180deg, rgba(15,15,17,0.92), rgba(12,16,22,0.98)),
    #090c10;
}

body::before {
  content: "";
  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: 10;
  background-image:
    repeating-linear-gradient(
      to bottom,
      rgba(255,255,255,0.02),
      rgba(255,255,255,0.02) 1px,
      transparent 1px,
      transparent 3px
    );
  opacity: 0.85;
  mix-blend-mode: screen;
}

.page-shell {
  width: 100%;
  min-height: 100vh;
  padding: 18px 22px 26px;
  background: #0a0d12;
  border-top: 2px solid rgba(255,255,255,0.04);
  border-bottom: 2px solid rgba(255,255,255,0.04);
}

.topbar {
  display: grid;
  grid-template-columns: 1.2fr 2.2fr 1fr;
  align-items: center;
  gap: 22px;
  min-height: 80px;
  padding: 6px 0 18px;
  border-bottom: 1px solid rgba(255,255,255,0.18);
}

.brand {
  display: flex;
  align-items: center;
}

.brand-text {
  font-family: "Orbitron", sans-serif;
  font-size: clamp(2.2rem, 4vw, 4.8rem);
  line-height: 0.9;
  font-weight: 900;
  letter-spacing: 0.02em;
  color: #f3efe9;
  text-shadow:
    2px 2px 0 rgba(0,0,0,0.8),
    0 0 8px rgba(255,255,255,0.08);
  transform: skew(-8deg);
  display: inline-block;
  white-space: nowrap;
}

.search-wrap {
  display: flex;
  align-items: center;
  width: 100%;
}

.search-wrap input {
  width: 100%;
  height: 52px;
  background: rgba(16,21,28,0.95);
  border: 1px solid rgba(255,255,255,0.14);
  border-radius: 2px;
  color: var(--text);
  padding: 0 18px;
  font-size: 1.05rem;
  outline: none;
  box-shadow: inset 0 1px 0 rgba(255,255,255,0.02);
}

.search-wrap input::placeholder {
  color: rgba(255,255,255,0.45);
}

.top-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 12px;
  flex-wrap: wrap;
}

.search-button {
  min-width: 110px;
  height: 52px;
  background: rgba(255,255,255,0.03);
  border: 1px solid rgba(255,255,255,0.12);
  border-radius: 2px;
  color: var(--text);
  font-size: 1.02rem;
  font-weight: 500;
  cursor: pointer;
}

.top-actions a {
  color: #4a90ff;
  text-decoration: none;
  font-size: 1.08rem;
  font-weight: 500;
}

.video-list {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18px 20px;
  padding-top: 26px;
}

.video-card {
  display: grid;
  grid-template-columns: 46% 54%;
  min-height: 220px;
  background: rgba(255,255,255,0.02);
  border: 1px solid rgba(255,255,255,0.09);
  border-radius: 3px;
  overflow: hidden;
  box-shadow: 0 0 0 1px rgba(255,255,255,0.01);
  padding: 8px;
}

.thumb {
  width: 100%;
  min-height: 180px;
  border-radius: 3px;
  border: 1px solid rgba(255,255,255,0.08);
  background-size: cover;
  background-position: center;
  filter: contrast(0.9) brightness(0.8) saturate(0.7) grayscale(0.12);
  box-shadow: inset 0 0 0 1px rgba(255,255,255,0.02);
}

.thumb-one {
  background-image:
    linear-gradient(rgba(0,0,0,0.06), rgba(0,0,0,0.18)),
    url("https://images.unsplash.com/photo-1517849845537-4d257902454a?auto=format&fit=crop&w=900&q=80");
}

.thumb-two {
  background-image:
    linear-gradient(rgba(0,0,0,0.06), rgba(0,0,0,0.18)),
    url("https://images.unsplash.com/photo-1517841905240-472988babdf9?auto=format&fit=crop&w=900&q=80");
}

.thumb-three {
  background-image:
    linear-gradient(rgba(0,0,0,0.06), rgba(0,0,0,0.18)),
    url("https://images.unsplash.com/photo-1504593811423-6dd665756598?auto=format&fit=crop&w=900&q=80");
}

.thumb-four {
  background-image:
    linear-gradient(rgba(0,0,0,0.08), rgba(0,0,0,0.18)),
    url("https://images.unsplash.com/photo-1524504388940-b1c1722653e1?auto=format&fit=crop&w=900&q=80");
}

.thumb-five {
  background-image:
    linear-gradient(rgba(0,0,0,0.08), rgba(0,0,0,0.18)),
    url("https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?auto=format&fit=crop&w=900&q=80");
}

.thumb-six {
  background-image:
    linear-gradient(rgba(0,0,0,0.08), rgba(0,0,0,0.18)),
    url("https://images.unsplash.com/photo-1521119989659-a83eee488004?auto=format&fit=crop&w=900&q=80");
}

.video-info {
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 10px 14px 10px 18px;
}

.title-pill {
  display: inline-block;
  width: fit-content;
  max-width: 100%;
  min-width: 180px;
  background: var(--blue);
  color: #edf7ff;
  border: 1px solid rgba(255,255,255,0.06);
  border-radius: 2px;
  padding: 10px 12px;
  font-size: clamp(1.1rem, 1.5vw, 2.1rem);
  font-weight: 700;
  letter-spacing: 0.01em;
  line-height: 1.2;
  box-shadow: inset 0 1px 0 rgba(255,255,255,0.15);
  transform: skew(-2deg);
  text-shadow: 1px 1px 0 rgba(0,0,0,0.2);
}

.meta-label {
  margin-top: 18px;
  font-size: 1.03rem;
  color: rgba(255,255,255,0.9);
}

.meta-sub {
  margin-top: 6px;
  font-size: 1.1rem;
  color: rgba(255,255,255,0.9);
}

.meta-sub span {
  color: #d9e6ff;
  font-weight: 500;
}

@media (max-width: 980px) {
  .topbar {
    grid-template-columns: 1fr;
  }

  .video-list {
    grid-template-columns: 1fr;
  }

  .video-card {
    grid-template-columns: 1fr;
  }

  .thumb {
    min-height: 220px;
  }
}

@media (max-width: 560px) {
  .page-shell {
    padding-inline: 12px;
  }

  .brand-text {
    font-size: 2.3rem;
  }

  .top-actions {
    justify-content: flex-start;
  }
}
